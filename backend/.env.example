# Copia este archivo como backend/.env y llena tus datos.
# El .env NO se sube a GitHub (esta en el .gitignore).

# postgresql://USUARIO:CONTRASENA@localhost:5432/NOMBRE_BASE
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/futciclar

# Clave para firmar los tokens. Cualquier texto largo y dificil de adivinar.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto

PORT=3000
